	(text "- ILIM_HIZ R702 51k / R703 100k from REGN: V = 3.18-3.31 V -> hardware input limit ILIM = 2.7-2.9 A"
		(at 30.48 219.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4ee5a006-c953-4fcf-8de5-5ffd40b3d3fe")
	)
	(text "- TS: RT1 R704 5.1k (REGN-TS), RT2 R705 30k (TS-GND), 10k NTC B3435 on battery sheet -> charge cold stop 2.0 C, hot stop 60.8 C; open NTC = cold (fail-safe)"
		(at 30.48 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9409448a-3956-45ed-b301-4f5d26f86f19")
	)
	(text "- I2C address 0x6B. /INT, SCL, SDA pull-ups on mcu sheet (R104-R106). /CE tied low via R707 10k (firmware uses EN_CHG). D+/D- NC"
		(at 30.48 227.33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "18a8c936-168e-4c7e-8e7c-17fbe6b97a15")
	)
	(text "- STAT LED D701 from REGN via R708 1k: I = (4.8 - 2.8) V / 1k = approx. 2 mA (low = charging, 1 Hz blink = fault)"
