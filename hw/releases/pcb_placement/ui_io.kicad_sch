	(text "UI / I2S I/O sheet notes"
		(at 63.5 195.58 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b6e0e0f9-b437-4116-bd08-8d272a9f849e")
	)
	(text "J501: 1.0 mm 20P FFC, bottom contact (JUSHUO AFA07-S20FCA-00). Same-side (Type A) cable: main-board pin n <-> UI-board pin (21 - n)."
		(at 63.5 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1edeb1ba-65bf-4d47-8b87-7d1a3ab1cae6")
	)
	(text "R501-R504 1k: ESD / hot-plug protection for the input-only ESP32 pins (UI board carries the 10k pull-ups)."
		(at 63.5 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e1c1e81c-dfd7-4515-bc86-dfb04fd88163")
	)
	(text "DEFAULT BUILD: R505-R507 0R links FITTED (ESP32 drives the amps directly); U501 SN74LVC157A and C503 DNP; J502 DNP (hand-fit)."
		(at 63.5 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "db6e420a-e305-4617-8ba3-b682dc0e5549")
	)
	(text "Variant I2S_EXT: fit U501 + C503, remove R505-R507. I2S_SEL high (J502 pin 5) selects the external 3.3 V I2S master; R508-R511 10k pull-downs always fitted."
		(at 63.5 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fd48cdb7-a48d-491a-8230-c41295c68e82")
	)
	(text "U501 uses the 74xx:74LS157 symbol (pin-identical to SN74LVC157A, mapped by pin number). Unused 4th channel: 4A/4B/G tied to GND, 4Y NC."
		(at 63.5 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "46141337-96b8-4843-a7de-09c262b88a9e")
	)
	(text "UI / I2S I/O: UI-board FFC and optional external I2S source"
		(at 40.64 33.02 0)
		(effects
			(font
				(size 3 3)
				(thickness 0.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ca3ecfbf-1b74-4a0e-ab7f-ef25fa3c290f")
	)
	(text "External I2S header + pull-downs (J502 DNP)"
		(at 40.64 58.42 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b5203727-cfe2-4985-9f9e-42fa260ea358")
	)
	(text "I2S source mux, variant I2S_EXT (U501, C503 DNP)"
		(at 149.86 55.88 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
