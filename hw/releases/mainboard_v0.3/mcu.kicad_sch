	(text "MCU sheet notes"
		(at 25.4 213.36 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "001fa767-dabb-484e-a240-e0df52a99b65")
	)
	(text "Straps: IO0 = 1 via R102 10k PU (SPI boot; BOOT SW102 / Q202 pull low for download). IO2 (BOOST_EN) = 0 via R107 100k PD. IO12 (AMP_PDN) = 0 via R108 100k PD (3.3 V flash). IO15 (LCD_DC) internal PU, leave."
		(at 25.4 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a672a7ae-68f4-4ab7-a751-0bc102c06ac5")
	)
	(text "I2C: R104/R105 2.2k to +3V3 are the only bus pull-ups; 400 kHz Fast-mode (t_r ~186 ns at ~100 pF)."
		(at 25.4 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5a0e8859-3e37-4035-b82c-6512e2edb235")
	)
	(text "I2C bus map (7-bit): 0x22/0x23 CH224Q, 0x2C/0x2D TAS5805M amps (L/R), 0x6B BQ2579x charger."
		(at 25.4 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "aad87081-2b5d-4a38-a6e9-404b0819c8d4")
	)
	(text "AMP_FAULT is ACTIVE-HIGH: Q102+Q101 (2N7002) in series form a NAND of AMPL/AMPR_FAULT_N; R109 100k PU. 1 = fault in either amp. Ignore until both amps configured (reg 0x61=0x0B, 0x60=0x01)."
		(at 25.4 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "75d0f559-05d9-491a-a54f-bfe96e7ab504")
	)
	(text "U101 NC pins 17-22 (flash), 27/28 (GPIO16/17 PSRAM), 32 are not in the vendored symbol: leave unconnected. Pin 39 EPAD to GND."
		(at 25.4 251.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "59b4d44f-e271-46b4-9c22-8f52232963a9")
	)
	(text "MCU: ESP32-WROVER-E module, reset/boot, strapping and I/O"
		(at 25.4 30.48 0)
		(effects
			(font
				(size 3 3)
				(thickness 0.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "960a0f08-2df8-4ef2-ae49-0c43846851f9")
	)
	(text "Pull-ups / pull-downs"
		(at 33.02 111.76 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a2b31263-fecc-4a3d-bd78-897f6b352809")
	)
	(text "Boot strap (IO0) + status LED"
		(at 264.16 121.92 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "89a38e83-c937-41e2-abe8-86fb18168562")
	)
	(text "Module decoupling"
		(at 205.74 88.9 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "41548fc5-0ee9-402b-9ab7-7d13754939d7")
	)
	(text "AMP fault merge (active-high)"
		(at 337.82 182.88 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "dd8d7da7-474a-48f6-ab19-7b606d711f3a")
	)
	(text "EN: R101 10k x C103 2.2uF = 22 ms RC delay (ECO-001). SW101 RESET to GND; Q201 (usb_uart) pulls ESP_EN low for auto-reset."
		(at 25.4 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f038a4c2-fd81-47c3-aada-1b9e219e7053")
	)
	(text "D101 status LED on IO0 (lit when IO0 low): drive GPIO0 open-drain only. R110-R118 source resistors: 33R, except R113/R114/R118 68R on the FFC SPI/PDM lines (ECO-001); IOxx_R nets are local."
		(at 25.4 246.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9501a257-e417-4bde-838e-6d146184a922")
	)
	(text "Reset / EN (22 ms RC)"
		(at 116.84 83.82 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b05747f9-2d91-406b-8d5e-1845e183de9a")
	)
