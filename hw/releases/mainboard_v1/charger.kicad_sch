	(text "BQ25792 2S NVDC BUCK-BOOST CHARGER - design notes"
		(at 101.6 220.98 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b6930b16-f082-4264-86a3-c1168795c072")
	)
	(text "- PROG R701 8.2k 1% -> 2S, fsw 750 kHz (requires L701 = 2.2 uH). POR: VREG 8.4 V, ICHG 1 A, VSYSMIN 7.0 V"
		(at 101.6 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "60a6ac44-7cb5-47ed-8828-6af95fd708be")
	)
	(text "- ILIM_HIZ R702 51k / R703 100k from REGN: V = 3.18-3.31 V -> hardware input limit ILIM = 2.7-2.9 A"
		(at 101.6 229.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0b94b1b6-1767-410f-9e67-723e9815448b")
	)
	(text "- TS: RT1 R704 5.1k (REGN-TS), RT2 R705 30k (TS-GND), 10k NTC B3435 on battery sheet -> charge cold stop 2.0 C, hot stop 60.8 C; open NTC = cold (fail-safe)"
		(at 101.6 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6088e6e4-eb9a-409a-8418-a868eab214ad")
	)
	(text "- I2C address 0x6B. /INT, SCL, SDA pull-ups on mcu sheet (R104-R106). /CE tied low via R707 10k (firmware uses EN_CHG). D+/D- NC"
		(at 101.6 237.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "55a16d3c-6e82-427b-976d-5a53eaf9e44d")
	)
	(text "- STAT LED D701 from REGN via R708 1k: I = (4.8 - 2.8) V / 1k = approx. 2 mA (low = charging, 1 Hz blink = fault)"
		(at 101.6 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "450b877c-f0fd-479f-819a-69e57d23dcca")
	)
	(text "- Q701 ship FET (S = CHG_BAT, D = VBAT_PACK), gate from SDRV via R709 0R. Firmware: SFET_PRESENT = 1, EN_BATOC = 1 (9.3 A IBAT_OCP). SW701 = QON wake / 10 s reset"
		(at 101.6 245.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "255edeb3-2120-469a-a034-2bfdae7fdac1")
	)
	(text "- DNP: C719 (BATP filter, 4S only), C720 (SFET gate-drain slow-start), R710 (SFET gate-source)"
		(at 101.6 248.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b4176ca2-b118-4207-8487-c2fd9a15ce9a")
	)
