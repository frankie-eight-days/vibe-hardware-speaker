	(text "USB-C INPUT / PD SINK (CH224Q) - design notes"
		(at 137.16 177.8 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d3dc6877-e83a-43c8-9bce-6f7791493f61")
	)
	(text "- CFG1 = R602 56k to GND: single-resistor mode, 15 V request at attach, I2C enabled (reg 0x0A: 0=5V 1=9V 2=12V 3=15V 4=20V; never 28V/EPR)"
		(at 137.16 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fd110110-cc4c-40cc-ae8f-26e23ea4bd9e")
	)
	(text "- CH224Q I2C address 0x22 or 0x23 (firmware probes both). Bus: TAS5805M 0x2C/0x2D, BQ25792 0x6B - no collisions"
		(at 137.16 186.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cd12265a-27b0-450b-8b8a-1738d0287ab2")
	)
	(text "- Q601/Q602 isolate CH224Q from shared I2C when VBUS absent. Gate PD_ISO_G = VBUS/2 (R603/R604 100k/100k): 2.5 V @5 V, 7.5 V @15 V, 10 V @20 V"
		(at 137.16 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e5bf2d31-24d9-456f-b9a4-0d7022b7c3cf")
	)
	(text "- Hot-plug snubber R601 2R0 + C602 2.2uF: DNP (sources attach at 5 V). D601 SMF24A within 3 mm of J601 VBUS pins"
		(at 137.16 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a4c4781-0851-46af-b424-0ed3b1e46b9d")
	)
	(text "- U601 VBUS pin -> +3V3 (not VBUS). U602 pin 5 NC (CC may carry Vconn 5.5 V). CH224Q DP/DM NC; Rd internal. EP (pin 11) = GND"
		(at 137.16 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ebdb9dcc-82fd-4ef3-9fad-39340b96b3b1")
	)
	(text "- DNP: R601, C602"
		(at 137.16 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "efc7c391-56c5-49ec-8ae3-6b3db39e80dc")
	)
