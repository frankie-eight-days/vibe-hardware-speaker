	(text "BATTERY: XT30 pack input, 10 A fuse, 2S low-side protection (R5460), cell balancing (HY2213), NTC select"
		(at 25.4 25.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "dc920707-32bd-4bca-ab0f-9eb83b2a1750")
	)
	(text "WARNING: BATT_N (cell negative) is NOT GND. Q801/Q802 sit between BATT_N and GND (= protected pack P-). Keep BATT_N copper separate."
		(at 139.7 35.56 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
				(color 200 0 0 1)
			)
			(justify left bottom)
		)
		(uuid "fa4a05a1-45e5-4d28-bbdf-b6151416d70d")
	)
	(text "Design notes"
		(at 139.7 160.02 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3fbe259c-0de7-49b0-af51-2e4765714b5d")
	)
	(text "U801 R5460N212AF: over-charge 4.29 V (release 4.05 V, 1.0 s); over-discharge 3.00 V (release 3.20 V, 128 ms; AF = release after charger connect)"
		(at 139.7 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "854657e8-253c-4242-9788-39fe93e1463b")
	)
	(text "Q801 discharge FET (DOUT), Q802 charge FET (COUT), common drain PROT_D, no gate resistors (Ricoh typ. application). R1=330R, R2=330R, R3=1k, C1/C2=100nF, C3=10nF."
		(at 139.7 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fe08fa3d-0e9a-4185-9bb9-a62c10daafb0")
	)
	(text "R810/R811 1M/1M bias BAL_MID = VBAT/2 when the balance lead is unplugged (4.2 uA). F801 10 A very fast, derated 7.5 A continuous."
		(at 139.7 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f247c493-25f5-454e-af22-4ab2fae57a8c")
	)
	(text "Jumper defaults: JP801 (balance B-) OPEN, JP802 (balance B+) OPEN - only the middle tap is used; JP803 bridged 1-2 = on-board TH801, cut and bridge 2-3 for external J803 NTC."
		(at 139.7 184.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "615b2f97-a7a8-491b-9ae5-d4314f4fce09")
	)
	(text "J803: isolated 2-wire 10k B3435 pack NTC only (never one referenced to cell negative - B- is not GND). J801 XT30: pin 2 = +, pin 1 = -. Verify balance-lead wire order."
		(at 139.7 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b0e7b4ca-ced6-493f-b987-6ccc267b7923")
	)
	(text "Excess discharge: V- above 0.200 V for 12 ms = 0.2 V / (2 x 2.5 mOhm), approx. 40 A; short: V- above 1.1 V for 300 us. Last resort only (BQ IBAT_OCP 9.3 A, boost ILIM, F801)."
		(at 139.7 168.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "61d04e09-a32f-49ad-8ac4-656e0756a0d6")
	)
	(text "Balancers U802/U803 HY2213-BB3A: ON above 4.200 V, OFF below 4.190 V; bleed 120R || 120R = 60R, 4.2 V / 60R = 70 mA per cell, 0.147 W per 1206 resistor."
		(at 139.7 176.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b96ae0e0-9314-4386-9a2e-f22c31a2afe2")
	)
