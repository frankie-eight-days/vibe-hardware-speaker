	(text "U801 R5460N212AF: over-charge 4.29 V (release 4.05 V, 1.0 s); over-discharge 3.00 V (release 3.20 V, 128 ms; AF = release after charger connect)"
		(at 25.4 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "56c4b5f2-fe1c-47f3-9b9c-68eb9b349fc3")
	)
	(text "Excess discharge: V- above 0.200 V for 12 ms = 0.2 V / (2 x 2.5 mOhm), approx. 40 A; short: V- above 1.1 V for 300 us. Last resort only (BQ IBAT_OCP 9.3 A, boost ILIM, F801)."
		(at 25.4 234.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d39216c0-a6d6-4153-9a3c-a1df0d5a6418")
	)
	(text "Q801 discharge FET (DOUT), Q802 charge FET (COUT), common drain PROT_D, no gate resistors (Ricoh typ. application). R1=330R, R2=330R, R3=1k, C1/C2=100nF, C3=10nF."
		(at 25.4 238.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "765600db-ab81-4a48-b8c3-7103a46999b4")
	)
	(text "Balancers U802/U803 HY2213-BB3A: ON above 4.200 V, OFF below 4.190 V; bleed 120R || 120R = 60R, 4.2 V / 60R = 70 mA per cell, 0.147 W per 1206 resistor."
		(at 25.4 242.57 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8be24856-bdca-4a58-a1df-7b2ec8d96034")
	)
	(text "R810/R811 1M/1M bias BAL_MID = VBAT/2 when the balance lead is unplugged (4.2 uA). F801 10 A very fast, derated 7.5 A continuous."
		(at 25.4 246.38 0)
		(effects
