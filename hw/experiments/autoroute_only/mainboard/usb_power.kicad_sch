	(text "USB-C INPUT, VBUS PROTECTION AND USB PD SINK (CH224Q)"
		(at 30.48 35.56 0)
		(effects
			(font
				(size 3 3)
				(thickness 0.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "f314fa49-166c-49d6-ab84-793e329379b8")
	)
	(text "Design notes"
		(at 30.48 209.55 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2d66cb44-ddcf-466f-8997-9ed4a50b9691")
	)
	(text "- CFG1 = R602 56k to GND: single-resistor mode, 15 V request at attach, I2C enabled (reg 0x0A: 0=5V 1=9V 2=12V 3=15V 4=20V; never 28V/EPR)"
		(at 30.48 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bacf3937-15f7-4d19-9b1f-43b68ffb1337")
	)
	(text "- CH224Q I2C address 0x22 or 0x23 (firmware probes both). Bus: TAS5805M 0x2C/0x2D, BQ25792 0x6B - no collisions"
		(at 30.48 219.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8f902c97-6e55-4ae2-b178-cc68b6028b91")
	)
	(text "- Q601/Q602 isolate CH224Q from shared I2C when VBUS absent. Gate PD_ISO_G = VBUS/2 (R603/R604 100k/100k): 2.5 V @5 V, 7.5 V @15 V, 10 V @20 V"
		(at 30.48 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c1c38de2-8ae3-492c-bbc8-f305d96d8010")
	)
	(text "- Hot-plug snubber R601 2R0 + C602 2.2uF: DNP (sources attach at 5 V). D601 SMF24A within 3 mm of J601 VBUS pins"
		(at 30.48 227.33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f15f0659-04e8-4f4b-a001-8dae87785447")
	)
	(text "- U601 VBUS pin -> +3V3 (not VBUS). U602 pin 5 NC (CC may carry Vconn 5.5 V). CH224Q DP/DM NC; Rd internal. EP (pin 11) = GND"
		(at 30.48 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3b5bb7de-2a3b-4495-ade3-db2ef6bc2aa8")
	)
