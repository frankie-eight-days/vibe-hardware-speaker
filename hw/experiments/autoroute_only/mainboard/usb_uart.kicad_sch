	(text "USB-UART sheet notes"
		(at 101.6 157.48 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "f16cfe5f-b4de-4f95-b52a-baf2ba0aa080")
	)
	(text "CH340C has a built-in oscillator: NO crystal. Pin 7 (XI on CH340G) must float. V3 tied to VCC (+3V3 supply). UD+/UD- connect directly (no series R). R232 tied to GND."
		(at 101.6 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f63d4a74-ca08-4344-94e2-b6b0d50b9b78")
	)
	(text "UART crossover: ESP_TXD0 -> R204 470R -> CH340C RXD; CH340C TXD -> R203 470R -> ESP_RXD0."
		(at 101.6 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ac3194dc-a56a-4d4b-921f-268a7ea18421")
	)
	(text "Auto-reset (DevKitC): DTR#,RTS# = 1,1 or 0,0 -> EN high, IO0 high (idle); 1,0 -> Q201 on, EN low (reset); 0,1 -> Q202 on, IO0 low (boot)."
		(at 101.6 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9355abcd-3867-4093-9908-c83214bb29ed")
	)
	(text "esptool steps (1,0) -> (0,1): EN rises while IO0 is held low = download mode. Place Q201/Q202 near U101 pins 3 and 25."
		(at 101.6 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5c742145-85a7-461a-a1d5-744d78efb4a9")
	)
	(text "USB-UART bridge (CH340C) and ESP32 auto-reset"
		(at 101.6 45.72 0)
		(effects
			(font
				(size 3 3)
				(thickness 0.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "8d677a19-1611-4a18-b5b6-5b1da227367d")
	)
	(text "Auto-reset: DTR# / RTS# cross-coupled NPN pair"
		(at 180.34 144.78 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7b55764d-5f1b-43d7-82d5-9c1ac7cc24ff")
	)
